# ==============================================================================
# Anime2Cap — Template de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para .env.local e preencha as credenciais correspondentes.
# NUNCA insira senhas ou chaves reais neste arquivo.

# ------------------------------------------------------------------------------
# 1. Banco de Dados (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# String de conexão do PostgreSQL gerenciado no Supabase (usado pelo Drizzle ORM).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Redis & Rate Limiting (Upstash)
# ------------------------------------------------------------------------------
# URL e Token de acesso à API REST do Upstash Redis (Rate limiting + Cache de consultas Jikan).
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ------------------------------------------------------------------------------
# 3. Inteligência Artificial & Busca Web (Ingestão & Tradução Destaques)
# ------------------------------------------------------------------------------
# Chave da API OpenRouter (utiliza Claude 3.5 Haiku para extração estruturada de mapeamentos e tradução dinâmica de sinopses).
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Chave da API Tavily AI Search (mecanismo de busca otimizado para IA usado na busca de mapeamentos Fandom/MAL).
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ------------------------------------------------------------------------------
# 4. APIs de Terceiros (Jikan MAL API)
# ------------------------------------------------------------------------------
# URL base da Jikan API v4 (API pública do MyAnimeList — gratuita, sem chave necessária).
JIKAN_API_URL=https://api.jikan.moe/v4

# ------------------------------------------------------------------------------
# 5. Segurança & Autenticação Interna
# ------------------------------------------------------------------------------
# Chave de segurança para proteger as rotas de API Administrativas (ex: seeding manual de mapeamentos).
ADMIN_API_KEY=change-me-to-a-secure-random-key

# ------------------------------------------------------------------------------
# 6. Configurações da Aplicação Web (Next.js Public Envs)
# ------------------------------------------------------------------------------
# URL pública base da aplicação (usada no sitemap, SEO, OpenGraph e chamadas de API).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 7. Observabilidade & Analytics (Opcional)
# ------------------------------------------------------------------------------
# DSN do Sentry para monitoramento e rastreamento de exceções em tempo real.
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0

# ID do Google AdSense para monetização (opcional).
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

# ID do Microsoft Clarity para análise de mapa de calor e comportamento do usuário (opcional).
NEXT_PUBLIC_CLARITY_ID=your-clarity-project-id

# Tags de Afiliado (Amazon & Crunchyroll)
NEXT_PUBLIC_AMAZON_TAG=anime2cap-20
NEXT_PUBLIC_CRUNCHYROLL_REF=anime2cap
